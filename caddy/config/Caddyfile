notes.itayvak.com {
    # Android launches an installed PWA as a cross-site navigation, which SiYuan rejects.
    # Allow that for the app's entry pages only; API requests stay protected.
    # TODO: delete this block once SiYuan is on v3.8.7 or later, which fixes it upstream
    # (https://github.com/siyuan-note/siyuan/issues/20058).
    @pwa_launch {
        method GET
        path / /stage/build/app/ /stage/build/desktop/ /stage/build/mobile/
        header Sec-Fetch-Site cross-site
        header Sec-Fetch-Mode navigate
        header Sec-Fetch-Dest document
    }
    request_header @pwa_launch Sec-Fetch-Site none

    reverse_proxy siyuan:6806
}

