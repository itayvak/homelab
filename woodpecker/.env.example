# GitHub OAuth app (GitHub > Settings > Developer settings > OAuth Apps)
# Homepage URL: https://ci.itayvak.com   Callback URL: https://ci.itayvak.com/authorize
WOODPECKER_GITHUB_CLIENT=
WOODPECKER_GITHUB_SECRET=
# Shared secret between server and agent. Create with: openssl rand -hex 32
WOODPECKER_AGENT_SECRET=
# Signs the server-agent connection. Create with: openssl rand -hex 32
WOODPECKER_GRPC_SECRET=
